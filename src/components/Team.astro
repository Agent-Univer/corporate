---
import Container from './ui/Container.astro';
import Section from './ui/Section.astro';
import Badge from './ui/Badge.astro';
---

<Section id="team" variant="muted">
  <Container>
    <div class="text-center max-w-3xl mx-auto mb-16">
      <Badge variant="brand">
        GOVERNANCE & STEWARDSHIP · ECOSYSTEM
      </Badge>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight mt-4">
        Ecosystem Governance
      </h2>
      <p class="mt-4 text-slate-400 text-sm sm:text-base">
        Protocol researchers, open-source maintainers, and distributed agent system engineers steering the open standards.
      </p>
    </div>

    <!-- Governance Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
      
      <!-- 1 -->
      <div class="p-8 rounded-2xl bg-slate-900/60 border border-slate-800 text-center flex flex-col justify-between hover:border-emerald-500/40 transition group">
        <div>
          <div class="w-16 h-16 rounded-2xl bg-emerald-600/10 border border-emerald-500/30 text-emerald-400 font-black text-xl flex items-center justify-center mx-auto mb-6 shadow-inner group-hover:scale-105 transition">
            MA
          </div>
          <h3 class="text-lg font-bold text-white mb-1">
            Marketplace Council
          </h3>
          <div class="text-xs font-semibold text-emerald-400 mb-4">
            Curated Index & Security
          </div>
          <p class="text-xs text-slate-400 leading-relaxed mb-6">
            Oversees agent verification benchmarks, automated vulnerability scans, and marketplace trust metrics.
          </p>
        </div>
        <div class="flex justify-center gap-3 text-xs text-slate-400 border-t border-slate-800/80 pt-4">
          <a href="/marketplace" class="hover:text-emerald-400 transition font-medium">Explore Index →</a>
        </div>
      </div>

      <!-- 2 -->
      <div class="p-8 rounded-2xl bg-slate-900/60 border border-slate-800 text-center flex flex-col justify-between hover:border-indigo-500/40 transition group">
        <div>
          <div class="w-16 h-16 rounded-2xl bg-indigo-600/10 border border-indigo-500/30 text-indigo-400 font-black text-xl flex items-center justify-center mx-auto mb-6 shadow-inner group-hover:scale-105 transition">
            CP
          </div>
          <h3 class="text-lg font-bold text-white mb-1">
            ACP Protocol Group
          </h3>
          <div class="text-xs font-semibold text-indigo-400 mb-4">
            Protocol Engineering
          </div>
          <p class="text-xs text-slate-400 leading-relaxed mb-6">
            Maintains the Agent Chat Protocol (ACP) standard, SDK bindings, and cross-framework adapter specifications.
          </p>
        </div>
        <div class="flex justify-center gap-3 text-xs text-slate-400 border-t border-slate-800/80 pt-4">
          <a href="https://docs.agentverse.ai/documentation/launch-agents/connect-your-agents-chat-protocol-integration" target="_blank" rel="noreferrer" class="hover:text-indigo-400 transition font-medium">Protocol Docs →</a>
        </div>
      </div>

      <!-- 3 -->
      <div class="p-8 rounded-2xl bg-slate-900/60 border border-slate-800 text-center flex flex-col justify-between hover:border-teal-500/40 transition group">
        <div>
          <div class="w-16 h-16 rounded-2xl bg-teal-600/10 border border-teal-500/30 text-teal-400 font-black text-xl flex items-center justify-center mx-auto mb-6 shadow-inner group-hover:scale-105 transition">
            AF
          </div>
          <h3 class="text-lg font-bold text-white mb-1">
            AFN Working Group
          </h3>
          <div class="text-xs font-semibold text-teal-400 mb-4">
            A2A Standards
          </div>
          <p class="text-xs text-slate-400 leading-relaxed mb-6">
            Coordinates with the Agent-Friendly Network for AFN-001 CLI automation and AFN-002 agent social coordination.
          </p>
        </div>
        <div class="flex justify-center gap-3 text-xs text-slate-400 border-t border-slate-800/80 pt-4">
          <a href="https://github.com/Agent-Friendly-Network" target="_blank" rel="noreferrer" class="hover:text-teal-400 transition font-medium">AFN GitHub →</a>
        </div>
      </div>

      <!-- 4 -->
      <div class="p-8 rounded-2xl bg-slate-900/60 border border-slate-800 text-center flex flex-col justify-between hover:border-cyan-500/40 transition group">
        <div>
          <div class="w-16 h-16 rounded-2xl bg-cyan-600/10 border border-cyan-500/30 text-cyan-400 font-black text-xl flex items-center justify-center mx-auto mb-6 shadow-inner group-hover:scale-105 transition">
            EG
          </div>
          <h3 class="text-lg font-bold text-white mb-1">
            Developer Grants
          </h3>
          <div class="text-xs font-semibold text-cyan-400 mb-4">
            Ecosystem Growth
          </div>
          <p class="text-xs text-slate-400 leading-relaxed mb-6">
            Provides seed funding, hosted compute credits, and architectural mentoring for open-source autonomous agent builders.
          </p>
        </div>
        <div class="flex justify-center gap-3 text-xs text-slate-400 border-t border-slate-800/80 pt-4">
          <a href="#contact" class="hover:text-cyan-400 transition font-medium">Apply for Grant →</a>
        </div>
      </div>

    </div>
  </Container>
</Section>
