---
import Container from './ui/Container.astro';
import Section from './ui/Section.astro';
import Badge from './ui/Badge.astro';
---

<Section id="contact" class="cta-glow relative overflow-hidden">
  <Container class="relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <Badge variant="brand">
        COLLABORATION · CONTACT
      </Badge>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight mt-4">
        Partner Program & Contact
      </h2>
      <p class="mt-4 text-slate-400 text-sm sm:text-base">
        Dedicated direct channel for enterprise deployments, solution integrators, agent developers, and institutional investors.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start max-w-5xl mx-auto">
      <!-- Left Direct Contact Card -->
      <div class="lg:col-span-5 p-8 rounded-3xl bg-slate-900/80 backdrop-blur-md border border-slate-800 space-y-6 shadow-xl shadow-black/40">
        <div>
          <h3 class="text-lg font-bold text-white mb-2">
            Direct Intake Channels
          </h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Our solutions architecture and business development team evaluates inquiries and responds within 24 business hours.
          </p>
        </div>

        <div class="space-y-4 pt-4 border-t border-slate-800 text-xs">
          <div>
            <div class="text-slate-500 mb-1">Business & Partnerships</div>
            <a href="mailto:contact@agentuniver.com" class="text-emerald-400 font-semibold text-sm hover:underline">
              contact@agentuniver.com
            </a>
          </div>

          <div>
            <div class="text-slate-500 mb-1">Investor Relations (IR)</div>
            <a href="mailto:ir@agentuniver.com" class="text-teal-400 font-semibold text-sm hover:underline">
              ir@agentuniver.com
            </a>
          </div>

          <div class="pt-2">
            <div class="text-slate-500 mb-1">Service SLA</div>
            <div class="text-slate-300 font-medium">Dedicated Lead Response within 24 Hours</div>
          </div>
        </div>
      </div>

      <!-- Right Form -->
      <div class="lg:col-span-7 p-8 rounded-3xl bg-slate-900/80 backdrop-blur-md border border-slate-800 shadow-xl shadow-black/40">
        <h3 class="text-xl font-bold text-white mb-6">
          Submit Collaboration Inquiry
        </h3>
        
        <form class="space-y-4" onsubmit="event.preventDefault(); alert('Thank you. Your inquiry has been received. Our team will contact you within 24 hours.');">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1.5">Your Name</label>
              <input 
                type="text" 
                required 
                class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white text-xs sm:text-sm focus:border-emerald-500 focus:outline-none transition" 
                placeholder="First and Last Name" 
              />
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1.5">Contact Phone / Email</label>
              <input 
                type="text" 
                required 
                class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white text-xs sm:text-sm focus:border-emerald-500 focus:outline-none transition" 
                placeholder="email@company.com" 
              />
            </div>
          </div>

          <div>
            <label class="block text-xs font-medium text-slate-400 mb-1.5">Collaboration Type</label>
            <select class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white text-xs sm:text-sm focus:border-emerald-500 focus:outline-none transition">
              <option>List Agent on Marketplace</option>
              <option>Enterprise ACP Integration & Gateway</option>
              <option>AFN Node Partnership & Grants</option>
              <option>Strategic Investment & IR</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-medium text-slate-400 mb-1.5">Project & Collaboration Details</label>
            <textarea 
              rows="4" 
              required
              class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white text-xs sm:text-sm focus:border-emerald-500 focus:outline-none transition" 
              placeholder="Briefly describe your organization background, timeline, and goals..."
            ></textarea>
          </div>

          <button 
            type="submit" 
            class="w-full py-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-sm transition shadow-lg shadow-emerald-600/30 hover:shadow-emerald-500/50 hover:scale-[1.01]"
          >
            Contact Us
          </button>
        </form>
      </div>
    </div>
  </Container>
</Section>
