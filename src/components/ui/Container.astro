---
interface Props {
  class?: string;
  size?: 'default' | 'wide' | 'narrow';
}

const { class: className = '', size = 'default' } = Astro.props;

const sizeClasses = {
  default: 'max-w-7xl',
  wide: 'max-w-[1440px]',
  narrow: 'max-w-4xl'
};
---

<div class={`mx-auto px-5 sm:px-8 lg:px-12 xl:px-16 w-full ${sizeClasses[size]} ${className}`}>
  <slot />
</div>
