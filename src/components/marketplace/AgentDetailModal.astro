---
// AgentDetailModal.astro - Agent details & connection spec modal
const sampleClientSnippet = `import os
from uagents import Agent, Context, Model

class Message(Model):
    text: str

agent = Agent(
    name="my_client_agent",
    seed=os.getenv("AGENT_SEED_PHRASE"),
    endpoint=["http://localhost:8000/submit"]
)

TARGET_ENDPOINT = "https://opencli.dev/api/v1/acp"

@agent.on_event("startup")
async def introduce(ctx: Context):
    ctx.logger.info("Connected to " + TARGET_ENDPOINT)
    await ctx.send(TARGET_ENDPOINT, Message(text="Hello from AgentUniver client"))

if __name__ == "__main__":
    agent.run()`;
---

<div id="agent-detail-modal" class="fixed inset-0 z-[100] hidden overflow-y-auto bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4 sm:p-6">
  <div class="relative w-full max-w-2xl bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl p-6 sm:p-8 overflow-hidden">
    <!-- Close Button -->
    <button 
      id="close-detail-modal" 
      class="absolute top-5 right-5 p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition"
      aria-label="Close modal"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Modal Header -->
    <div class="flex items-start gap-4 mb-6">
      <div id="modal-agent-avatar" class="w-14 h-14 rounded-xl bg-gradient-to-br from-emerald-600 to-teal-700 flex items-center justify-center text-2xl font-black text-white shadow-md flex-shrink-0">
        AU
      </div>
      <div>
        <div class="flex items-center gap-2">
          <h2 id="modal-agent-name" class="text-xl font-bold text-white leading-tight">Agent Name</h2>
          <span id="modal-agent-protocol" class="px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 uppercase">
            ACP v1.0
          </span>
        </div>
        <p class="text-xs text-slate-400 mt-1 flex items-center gap-2">
          <span id="modal-agent-author">by Author</span>
          <span>•</span>
          <span id="modal-agent-stack" class="font-mono text-slate-300">Stack</span>
          <span>•</span>
          <span id="modal-agent-runs" class="text-slate-400">0 runs</span>
        </p>
      </div>
    </div>

    <!-- Description -->
    <p id="modal-agent-desc" class="text-slate-300 text-sm leading-relaxed mb-6 bg-slate-950/50 p-3.5 rounded-xl border border-slate-800/80">
      Agent description text
    </p>

    <!-- Keywords -->
    <div class="mb-6">
      <h4 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Registered Keywords</h4>
      <div id="modal-agent-keywords" class="flex flex-wrap gap-1.5">
        <!-- Injected via JS -->
      </div>
    </div>

    <!-- Connection Endpoint & Specs -->
    <div class="mb-6 space-y-3">
      <h4 class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Agent Endpoint & ACP Integration</h4>
      
      <div class="bg-slate-950 rounded-xl p-3.5 border border-slate-800 flex items-center justify-between gap-3">
        <div class="flex items-center gap-2 overflow-hidden">
          <span class="text-xs text-emerald-400 font-mono font-semibold flex-shrink-0">ENDPOINT</span>
          <code id="modal-agent-endpoint" class="text-xs text-slate-300 font-mono truncate">https://api.agentuniver.com/acp</code>
        </div>
        <button id="copy-endpoint-btn" class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-medium border border-slate-700 transition flex-shrink-0">
          Copy
        </button>
      </div>

      <!-- Environment Setup Spec -->
      <div class="bg-slate-950/70 rounded-xl p-3.5 border border-slate-800 text-xs text-slate-300 space-y-2">
        <div class="flex items-center justify-between text-slate-400 font-medium">
          <span>Required Environment Variables</span>
          <span class="text-[10px] text-emerald-400 bg-emerald-500/10 px-1.5 py-0.5 rounded">Python 3.10+</span>
        </div>
        <div class="font-mono text-[11px] space-y-1 text-slate-400">
          <div>export <span class="text-emerald-300">AGENT_SEED_PHRASE</span>="your secret mnemonic seed phrase"</div>
          <div>export <span class="text-emerald-300">AGENTVERSE_KEY</span>="au_live_sec_****************"</div>
        </div>
      </div>
    </div>

    <!-- Integration Code Snippets -->
    <div class="mb-6">
      <div class="flex items-center justify-between mb-2">
        <h4 class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Quick Connect Code</h4>
        <button id="copy-code-btn" class="text-xs text-emerald-400 hover:text-emerald-300 transition">
          Copy Python Snippet
        </button>
      </div>
      <pre class="bg-slate-950 text-slate-300 text-xs p-4 rounded-xl border border-slate-800 font-mono overflow-x-auto"><code id="modal-code-snippet">{sampleClientSnippet}</code></pre>
    </div>

    <!-- Actions -->
    <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-800">
      <button 
        id="modal-test-chat-btn"
        class="px-4 py-2 rounded-xl text-xs font-semibold bg-emerald-600 hover:bg-emerald-500 text-white transition shadow-md shadow-emerald-600/30 flex items-center gap-1.5"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
        </svg>
        <span>Open Chat Playground</span>
      </button>
    </div>
  </div>
</div>

<script>
  let currentAgentData: any = null;

  function setupDetailModal() {
    const modal = document.getElementById('agent-detail-modal');
    const closeBtn = document.getElementById('close-detail-modal');
    const detailBtns = document.querySelectorAll('.open-detail-btn');
    const copyEndpointBtn = document.getElementById('copy-endpoint-btn');
    const copyCodeBtn = document.getElementById('copy-code-btn');
    const testChatBtn = document.getElementById('modal-test-chat-btn');

    detailBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const raw = (e.currentTarget as HTMLElement).getAttribute('data-agent');
        if (!raw) return;
        try {
          const agent = JSON.parse(raw);
          currentAgentData = agent;
          openModalWithAgent(agent);
        } catch (err) {
          console.error("Failed to parse agent json", err);
        }
      });
    });

    closeBtn?.addEventListener('click', () => {
      modal?.classList.add('hidden');
    });

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.add('hidden');
      }
    });

    copyEndpointBtn?.addEventListener('click', () => {
      const endpoint = document.getElementById('modal-agent-endpoint')?.textContent;
      if (endpoint) {
        navigator.clipboard.writeText(endpoint);
        copyEndpointBtn.textContent = 'Copied!';
        setTimeout(() => { copyEndpointBtn.textContent = 'Copy'; }, 2000);
      }
    });

    copyCodeBtn?.addEventListener('click', () => {
      const code = document.getElementById('modal-code-snippet')?.textContent;
      if (code) {
        navigator.clipboard.writeText(code);
        copyCodeBtn.textContent = 'Copied!';
        setTimeout(() => { copyCodeBtn.textContent = 'Copy Python Snippet'; }, 2000);
      }
    });

    testChatBtn?.addEventListener('click', () => {
      if (currentAgentData) {
        modal?.classList.add('hidden');
        const chatModal = document.getElementById('agent-chat-modal');
        if (chatModal && (window as any).openChatWithAgent) {
          (window as any).openChatWithAgent(currentAgentData);
        }
      }
    });
  }

  function openModalWithAgent(agent: any) {
    const modal = document.getElementById('agent-detail-modal');
    if (!modal) return;

    const avatarEl = document.getElementById('modal-agent-avatar');
    const nameEl = document.getElementById('modal-agent-name');
    const protocolEl = document.getElementById('modal-agent-protocol');
    const authorEl = document.getElementById('modal-agent-author');
    const stackEl = document.getElementById('modal-agent-stack');
    const runsEl = document.getElementById('modal-agent-runs');
    const descEl = document.getElementById('modal-agent-desc');
    const endpointEl = document.getElementById('modal-agent-endpoint');
    const keywordsEl = document.getElementById('modal-agent-keywords');
    const codeSnippetEl = document.getElementById('modal-code-snippet');

    if (avatarEl) avatarEl.textContent = agent.name.slice(0, 2).toUpperCase();
    if (nameEl) nameEl.textContent = agent.name;
    if (protocolEl) protocolEl.textContent = agent.protocol;
    if (authorEl) authorEl.textContent = `by ${agent.author}`;
    if (stackEl) stackEl.textContent = agent.stack;
    if (runsEl) runsEl.textContent = `${agent.runs} runs`;
    if (descEl) descEl.textContent = agent.description;
    if (endpointEl) endpointEl.textContent = agent.endpoint;

    if (keywordsEl) {
      keywordsEl.innerHTML = agent.keywords.map((kw: string) => 
        `<span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-slate-800 text-slate-300 border border-slate-700">#${kw}</span>`
      ).join('');
    }

    if (codeSnippetEl) {
      codeSnippetEl.textContent = `import os
from uagents import Agent, Context, Model

class Message(Model):
    text: str

agent = Agent(
    name="my_client_agent",
    seed=os.getenv("AGENT_SEED_PHRASE", "default_seed_phrase"),
    endpoint=["http://localhost:8000/submit"]
)

TARGET_ENDPOINT = "${agent.endpoint}"

@agent.on_event("startup")
async def introduce(ctx: Context):
    ctx.logger.info(f"Connected to ${agent.name} at {TARGET_ENDPOINT}")
    await ctx.send(TARGET_ENDPOINT, Message(text="Hello from AgentUniver client"))

if __name__ == "__main__":
    agent.run()`;
    }

    modal.classList.remove('hidden');
  }

  // Expose global handler
  (window as any).openDetailWithAgent = openModalWithAgent;

  window.addEventListener('open_detail_modal', (e: any) => {
    const agentId = e.detail?.id;
    // Look up agent or pass detail
    if (e.detail?.name) {
      openModalWithAgent(e.detail);
    }
  });

  document.addEventListener('DOMContentLoaded', setupDetailModal);
  setupDetailModal();
</script>
