---
// AgentChatModal.astro - Interactive ACP Agent Chat Playground Modal
---

<div id="agent-chat-modal" class="fixed inset-0 z-[100] hidden overflow-y-auto bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4 sm:p-6">
  <div class="relative w-full max-w-2xl bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl flex flex-col h-[600px] overflow-hidden">
    <!-- Modal Header -->
    <div class="p-4 sm:p-5 border-b border-slate-800 flex items-center justify-between bg-slate-950/60">
      <div class="flex items-center gap-3">
        <div id="chat-agent-avatar" class="w-10 h-10 rounded-xl bg-emerald-600 flex items-center justify-center font-bold text-white shadow-sm flex-shrink-0">
          AU
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h3 id="chat-agent-name" class="font-bold text-white text-sm">Agent Name</h3>
            <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              ACP Handshake Live
            </span>
          </div>
          <p id="chat-agent-endpoint" class="text-[11px] font-mono text-slate-400 truncate max-w-xs sm:max-w-md">
            https://api.agentuniver.com/acp
          </p>
        </div>
      </div>

      <button 
        id="close-chat-modal" 
        class="p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition"
        aria-label="Close modal"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Message Area -->
    <div id="chat-messages-container" class="flex-1 p-4 sm:p-5 overflow-y-auto space-y-4 text-xs sm:text-sm bg-slate-900/50">
      <!-- Welcome System Message -->
      <div class="flex items-start gap-3">
        <div class="w-8 h-8 rounded-lg bg-emerald-600/20 text-emerald-400 border border-emerald-500/30 flex items-center justify-center font-bold text-xs flex-shrink-0">
          SYS
        </div>
        <div class="bg-slate-800/80 rounded-2xl rounded-tl-none p-3 text-slate-200 border border-slate-700/60 max-w-md">
          <p id="chat-welcome-msg">Agent initialized and ready. Type a prompt or select a sample query below to test ACP message exchange.</p>
        </div>
      </div>
    </div>

    <!-- Preset Sample Prompts -->
    <div class="px-4 py-2 bg-slate-950/40 border-t border-slate-800/60 flex items-center gap-2 flex-wrap no-scrollbar">
      <span class="text-[10px] text-slate-500 font-semibold uppercase flex-shrink-0">Quick Try:</span>
      <button id="sample-prompt-btn" class="px-2.5 py-1 rounded-lg bg-slate-800/80 hover:bg-slate-800 text-[11px] text-slate-300 border border-slate-700/80 transition flex-shrink-0 truncate max-w-xs">
        Sample prompt
      </button>
    </div>

    <!-- Input Form -->
    <form id="chat-input-form" class="p-3 sm:p-4 border-t border-slate-800 bg-slate-950/80 flex items-center gap-2">
      <input 
        id="chat-input-text"
        type="text" 
        placeholder="Send message via Agent Chat Protocol..." 
        class="flex-1 bg-slate-900 border border-slate-700/80 focus:border-emerald-500 rounded-xl px-4 py-2.5 text-xs sm:text-sm text-slate-100 placeholder-slate-500 focus:outline-none transition"
        autocomplete="off"
        required
      />
      <button 
        type="submit"
        id="chat-send-btn"
        class="px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs sm:text-sm font-semibold transition shadow-md shadow-emerald-600/30 flex items-center gap-1.5 flex-shrink-0"
      >
        <span>Send</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </button>
    </form>
  </div>
</div>

<script>
  let activeChatAgent: any = null;

  function setupChatModal() {
    const modal = document.getElementById('agent-chat-modal');
    const closeBtn = document.getElementById('close-chat-modal');
    const chatBtns = document.querySelectorAll('.open-chat-btn');
    const form = document.getElementById('chat-input-form');
    const input = document.getElementById('chat-input-text') as HTMLInputElement;
    const sampleBtn = document.getElementById('sample-prompt-btn');

    chatBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const raw = (e.currentTarget as HTMLElement).getAttribute('data-agent');
        if (!raw) return;
        try {
          const agent = JSON.parse(raw);
          openChatWithAgent(agent);
        } catch (err) {
          console.error("Failed to parse chat agent json", err);
        }
      });
    });

    closeBtn?.addEventListener('click', () => {
      modal?.classList.add('hidden');
    });

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) modal.classList.add('hidden');
    });

    sampleBtn?.addEventListener('click', () => {
      if (activeChatAgent && activeChatAgent.samplePrompt && input) {
        input.value = activeChatAgent.samplePrompt;
        input.focus();
      }
    });

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const text = input.value.trim();
      if (!text || !activeChatAgent) return;

      appendUserMessage(text);
      input.value = '';

      // Simulate ACP Protocol Dispatch & Response
      simulateAgentResponse(activeChatAgent, text);
    });
  }

  function openChatWithAgent(agent: any) {
    activeChatAgent = agent;
    const modal = document.getElementById('agent-chat-modal');
    if (!modal) return;

    const avatarEl = document.getElementById('chat-agent-avatar');
    const nameEl = document.getElementById('chat-agent-name');
    const endpointEl = document.getElementById('chat-agent-endpoint');
    const welcomeMsgEl = document.getElementById('chat-welcome-msg');
    const sampleBtn = document.getElementById('sample-prompt-btn');
    const container = document.getElementById('chat-messages-container');

    if (avatarEl) avatarEl.textContent = agent.name.slice(0, 2).toUpperCase();
    if (nameEl) nameEl.textContent = agent.name;
    if (endpointEl) endpointEl.textContent = `ACP Endpoint: ${agent.endpoint}`;
    if (welcomeMsgEl) {
      welcomeMsgEl.textContent = `Connected to ${agent.name} (${agent.protocol}). Powered by ${agent.stack}. Category: ${agent.category}.`;
    }
    if (sampleBtn) {
      sampleBtn.textContent = agent.samplePrompt || "Perform system health check";
    }

    if (container) {
      container.innerHTML = `
        <div class="flex items-start gap-3">
          <div class="w-8 h-8 rounded-lg bg-emerald-600/20 text-emerald-400 border border-emerald-500/30 flex items-center justify-center font-bold text-xs flex-shrink-0">
            SYS
          </div>
          <div class="bg-slate-800/80 rounded-2xl rounded-tl-none p-3 text-slate-200 border border-slate-700/60 max-w-md">
            <p>Connected to <strong>${agent.name}</strong> (${agent.protocol}). Stack: <code>${agent.stack}</code>. Endpoint: <code>${agent.endpoint}</code></p>
          </div>
        </div>
      `;
    }

    modal.classList.remove('hidden');
  }

  function appendUserMessage(text: string) {
    const container = document.getElementById('chat-messages-container');
    if (!container) return;

    const msgHtml = `
      <div class="flex items-start justify-end gap-3">
        <div class="bg-emerald-600 text-white rounded-2xl rounded-tr-none p-3 max-w-md shadow-sm">
          <p>${escapeHtml(text)}</p>
        </div>
        <div class="w-8 h-8 rounded-lg bg-emerald-700 text-white flex items-center justify-center font-bold text-xs flex-shrink-0">
          YOU
        </div>
      </div>
    `;
    container.insertAdjacentHTML('beforeend', msgHtml);
    container.scrollTop = container.scrollHeight;
  }

  function simulateAgentResponse(agent: any, prompt: string) {
    const container = document.getElementById('chat-messages-container');
    if (!container) return;

    // Loading indicator
    const loadingId = 'loading-' + Date.now();
    const loadingHtml = `
      <div id="${loadingId}" class="flex items-start gap-3">
        <div class="w-8 h-8 rounded-lg bg-slate-800 text-emerald-400 border border-slate-700 flex items-center justify-center font-bold text-xs flex-shrink-0">
          ${agent.name.slice(0, 2).toUpperCase()}
        </div>
        <div class="bg-slate-800/80 rounded-2xl rounded-tl-none p-3 text-slate-400 border border-slate-700/60 text-xs flex items-center gap-2">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span>Dispatching ACP request to ${agent.endpoint}...</span>
        </div>
      </div>
    `;
    container.insertAdjacentHTML('beforeend', loadingHtml);
    container.scrollTop = container.scrollHeight;

    setTimeout(() => {
      const loadingEl = document.getElementById(loadingId);
      if (loadingEl) loadingEl.remove();

      let reply = `[ACP Handshake 200 OK]\nExecuted task via ${agent.stack} architecture.\nTarget: ${agent.endpoint}\nKeywords: ${agent.keywords.join(", ")}\nResult payload generated successfully.`;
      if (agent.category === "finance") {
        reply = `[FinSense Report]\nProcessed variance analysis for "${prompt}".\n• Revenue delta: +14.2% YoY\n• Risk Score: 12.8 / 100 (Nominal)\n• SEC 10-Q filing references aligned.`;
      } else if (agent.category === "automation") {
        reply = `[OpenCLI Automation Execution]\nCommand parsed: "${prompt}".\nJSON Output:\n{\n  "status": "success",\n  "exit_code": 0,\n  "execution_time_ms": 142,\n  "agent_id": "${agent.id}"\n}`;
      } else if (agent.category === "personal assistant") {
        reply = `[Executive Assistant]\nUnderstood: "${prompt}".\nLogged task into three-track management ledger (Management/Reality/AI). Notification dispatched to subscribed endpoints.`;
      }

      const replyHtml = `
        <div class="flex items-start gap-3">
          <div class="w-8 h-8 rounded-lg bg-slate-800 text-emerald-400 border border-slate-700 flex items-center justify-center font-bold text-xs flex-shrink-0">
            ${agent.name.slice(0, 2).toUpperCase()}
          </div>
          <div class="bg-slate-800/90 rounded-2xl rounded-tl-none p-3.5 text-slate-200 border border-slate-700/80 max-w-lg space-y-2">
            <pre class="font-mono text-xs whitespace-pre-wrap leading-relaxed text-slate-300">${escapeHtml(reply)}</pre>
            <div class="pt-2 border-t border-slate-700/60 flex items-center justify-between text-[10px] text-slate-400">
              <span>Latency: 184ms</span>
              <span class="text-emerald-400 font-mono">ACP-PROTO-v1.0</span>
            </div>
          </div>
        </div>
      `;
      container.insertAdjacentHTML('beforeend', replyHtml);
      container.scrollTop = container.scrollHeight;
    }, 900);
  }

  function escapeHtml(str: string) {
    return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }

  // Expose globally
  (window as any).openChatWithAgent = openChatWithAgent;

  window.addEventListener('open_chat_modal', (e: any) => {
    if (e.detail) {
      openChatWithAgent(e.detail);
    }
  });

  document.addEventListener('DOMContentLoaded', setupChatModal);
  setupChatModal();
</script>
