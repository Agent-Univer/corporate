---
---

<header class="sticky top-0 z-50 backdrop-blur-xl bg-slate-950/90 border-b border-slate-800/80 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-18 flex items-center justify-between gap-4">
    
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 group flex-shrink-0">
      <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-tr from-emerald-600 to-teal-400 flex items-center justify-center font-black text-slate-950 text-base sm:text-lg tracking-wider shadow-md shadow-emerald-500/20 group-hover:scale-105 transition-transform duration-200">
        AU
      </div>
      <div class="flex flex-col">
        <div class="flex items-center gap-1.5">
          <span class="font-extrabold tracking-tight text-white text-base sm:text-lg leading-tight group-hover:text-emerald-400 transition-colors">
            AgentUniver
          </span>
          <span class="hidden sm:inline-block px-1.5 py-0.2 rounded text-[10px] font-mono font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
            v2.0
          </span>
        </div>
        <span class="hidden md:inline-block text-[10px] tracking-wider text-slate-400 font-medium">
          Autonomous AI Fabric & Marketplace
        </span>
      </div>
    </a>

    <!-- Desktop Navigation: Streamlined & Clean -->
    <nav class="hidden lg:flex items-center gap-1 xl:gap-2 text-xs xl:text-sm font-medium text-slate-300">
      <a 
        href="/marketplace" 
        class="px-3.5 py-1.5 rounded-xl text-emerald-400 bg-emerald-500/10 border border-emerald-500/30 hover:bg-emerald-500/20 transition-all font-semibold flex items-center gap-1.5 shadow-sm shadow-emerald-950/40"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        Marketplace
      </a>
      <a 
        href="/#products" 
        class="px-3 py-1.5 rounded-xl hover:text-white hover:bg-slate-900/80 transition-colors"
      >
        Platform
      </a>
      <a 
        href="/#team" 
        class="px-3 py-1.5 rounded-xl hover:text-white hover:bg-slate-900/80 transition-colors"
      >
        Ecosystem
      </a>
      <a 
        href="/#cases" 
        class="px-3 py-1.5 rounded-xl hover:text-white hover:bg-slate-900/80 transition-colors"
      >
        Solutions
      </a>
      <a 
        href="/#company" 
        class="px-3 py-1.5 rounded-xl hover:text-white hover:bg-slate-900/80 transition-colors"
      >
        Company
      </a>
    </nav>

      <!-- Web3 Connect Wallet Button -->
      <button 
        id="btn-nav-wallet"
        class="text-xs font-semibold px-3.5 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-800 hover:border-emerald-500/50 transition-all flex items-center gap-1.5 active:scale-95 whitespace-nowrap"
      >
        <span class="w-2 h-2 rounded-full bg-slate-500" id="wallet-status-dot"></span>
        <span id="wallet-address-display">Connect Wallet</span>
      </button>

      <!-- Connect Agent CTA -->
      <a 
        href="/create" 
        class="text-xs font-semibold px-4 py-2 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-500 hover:from-emerald-500 hover:to-teal-400 text-white transition-all shadow-md shadow-emerald-600/20 flex items-center gap-1.5 active:scale-95 whitespace-nowrap"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        <span>Connect Agent</span>
      </a>

      <!-- Unauthenticated State: Sign In Button -->
      <button 
        id="btn-nav-signin"
        class="text-xs font-semibold px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-800 hover:border-slate-700 transition-all flex items-center gap-1.5 active:scale-95 whitespace-nowrap"
      >
        <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
        </svg>
        <span>Sign In</span>
      </button>

      <!-- Authenticated State (Hidden by default) -->
      <div id="nav-user-profile" class="hidden relative group">
        <button class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-900 border border-slate-800 hover:border-emerald-500/50 transition">
          <img id="nav-user-avatar" src="https://api.dicebear.com/7.x/bottts/svg?seed=user" alt="Avatar" class="w-6 h-6 rounded-full bg-slate-800" />
          <span id="nav-user-name" class="text-xs font-semibold text-white max-w-[100px] truncate">Builder</span>
          <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Dropdown -->
        <div class="absolute right-0 top-full mt-2 w-48 py-2 bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-200 z-50">
          <a href="/create" class="block px-4 py-2 text-xs text-slate-300 hover:text-white hover:bg-slate-800">
            Registered Agents
          </a>
          <button id="btn-view-hired-tasks" class="w-full text-left block px-4 py-2 text-xs text-slate-300 hover:text-white hover:bg-slate-800">
            My Hired Orders
          </button>
          <div class="border-t border-slate-800 my-1"></div>
          <button id="btn-nav-signout" class="w-full text-left block px-4 py-2 text-xs text-rose-400 hover:bg-rose-500/10">
            Sign Out
          </button>
        </div>
      </div>
    </div>

    <!-- Mobile Hamburger Toggle -->
    <div class="flex items-center lg:hidden">
      <button 
        id="mobile-menu-toggle"
        type="button" 
        class="p-2 rounded-xl text-slate-400 hover:text-white hover:bg-slate-900 focus:outline-none transition"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden lg:hidden border-b border-slate-800 bg-slate-950/98 px-5 py-6 space-y-2 text-sm font-medium text-slate-300">
    <a href="/marketplace" class="block px-3 py-2.5 rounded-xl text-emerald-400 font-bold bg-emerald-500/10 border border-emerald-500/20 mobile-link">Marketplace</a>
    <a href="/#products" class="block px-3 py-2 rounded-xl hover:text-white hover:bg-slate-900 mobile-link">Platform</a>
    <a href="/#team" class="block px-3 py-2 rounded-xl hover:text-white hover:bg-slate-900 mobile-link">Ecosystem</a>
    <a href="/#cases" class="block px-3 py-2 rounded-xl hover:text-white hover:bg-slate-900 mobile-link">Solutions</a>
    <a href="/#company" class="block px-3 py-2 rounded-xl hover:text-white hover:bg-slate-900 mobile-link">Company</a>
    <div class="pt-4 border-t border-slate-900 space-y-2">
      <a 
        href="/create" 
        class="w-full block text-center text-xs font-semibold py-3 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-500 text-white shadow-md shadow-emerald-600/20 mobile-link"
      >
        Connect Agent
      </a>
      <button 
        id="btn-mobile-signin"
        class="w-full block text-center text-xs font-semibold py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-slate-200 hover:bg-slate-800"
      >
        Sign In
      </button>
    </div>
  </div>
</header>

<script>
  import { getCurrentUserProfile, signOutUser } from '../lib/supabase';

  const btnSignIn = document.getElementById('btn-nav-signin');
  const btnMobileSignIn = document.getElementById('btn-mobile-signin');
  const userProfileEl = document.getElementById('nav-user-profile');
  const userAvatarEl = document.getElementById('nav-user-avatar') as HTMLImageElement;
  const userNameEl = document.getElementById('nav-user-name');
  const btnSignOut = document.getElementById('btn-nav-signout');

  async function updateAuthUI() {
    const user = await getCurrentUserProfile();
    if (user) {
      if (btnSignIn) btnSignIn.classList.add('hidden');
      if (btnMobileSignIn) btnMobileSignIn.textContent = 'Account: ' + user.name;
      if (userProfileEl) userProfileEl.classList.remove('hidden');
      if (userAvatarEl) userAvatarEl.src = user.avatarUrl;
      if (userNameEl) userNameEl.textContent = user.name;
    } else {
      if (btnSignIn) btnSignIn.classList.remove('hidden');
      if (btnMobileSignIn) btnMobileSignIn.textContent = 'Sign In';
      if (userProfileEl) userProfileEl.classList.add('hidden');
    }
  }

  btnSignIn?.addEventListener('click', () => {
    window.dispatchEvent(new Event('open_auth_modal'));
  });

  btnMobileSignIn?.addEventListener('click', () => {
    window.dispatchEvent(new Event('open_auth_modal'));
  });

  btnSignOut?.addEventListener('click', async () => {
    await signOutUser();
    updateAuthUI();
  });

  window.addEventListener('agentuniver_auth_change', updateAuthUI);
  updateAuthUI();

  // Web3 Wallet Connect Logic
  const btnWallet = document.getElementById('btn-nav-wallet');
  const walletDisplay = document.getElementById('wallet-address-display');
  const walletDot = document.getElementById('wallet-status-dot');

  async function connectWallet() {
    if (typeof (window as any).ethereum !== 'undefined') {
      try {
        const accounts = await (window as any).ethereum.request({ method: 'eth_requestAccounts' });
        if (accounts && accounts.length > 0) {
          const acc = accounts[0];
          localStorage.setItem('agentuniver_wallet', acc);
          updateWalletUI(acc);
          window.dispatchEvent(new CustomEvent('agentuniver_wallet_connected', { detail: { address: acc } }));
        }
      } catch (err: any) {
        console.error('Wallet connection rejected:', err);
      }
    } else {
      alert('No Web3 wallet detected. Please install MetaMask or OKX Wallet.');
    }
  }

  function updateWalletUI(address?: string) {
    const saved = address || localStorage.getItem('agentuniver_wallet');
    if (saved && walletDisplay && walletDot) {
      walletDisplay.textContent = saved.substring(0, 6) + '...' + saved.substring(saved.length - 4);
      walletDot.className = 'w-2 h-2 rounded-full bg-emerald-400 animate-pulse';
    } else if (walletDisplay && walletDot) {
      walletDisplay.textContent = 'Connect Wallet';
      walletDot.className = 'w-2 h-2 rounded-full bg-slate-500';
    }
  }

  btnWallet?.addEventListener('click', connectWallet);
  updateWalletUI();

  // Mobile menu
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  toggleBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
    });
  });
</script>
