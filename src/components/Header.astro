---
---

<header class="sticky top-0 z-50 w-full backdrop-blur-xl bg-slate-950/90 border-b border-slate-800/80 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-18 flex items-center justify-between gap-3 sm:gap-4">
    
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 sm:gap-3 group flex-shrink-0">
      <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-tr from-emerald-600 to-teal-400 flex items-center justify-center font-black text-slate-950 text-base sm:text-lg tracking-wider shadow-md shadow-emerald-500/20 group-hover:scale-105 transition-transform duration-200">
        AU
      </div>
      <div class="flex flex-col">
        <div class="flex items-center gap-1.5">
          <span class="font-extrabold tracking-tight text-white text-base sm:text-lg leading-tight group-hover:text-emerald-400 transition-colors">
            AgentUniver
          </span>
          <span class="hidden sm:inline-block px-1.5 py-0.2 rounded text-[10px] font-mono font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
            v2.0
          </span>
        </div>
        <span class="hidden md:inline-block text-[10px] tracking-wider text-slate-400 font-medium">
          Autonomous AI Fabric & Marketplace
        </span>
      </div>
    </a>

    <!-- Desktop Navigation: Streamlined & Converged -->
    <nav class="hidden md:flex items-center gap-1 xl:gap-2 text-xs xl:text-sm font-medium text-slate-300">
      <a 
        href="/marketplace" 
        class="px-2.5 xl:px-3 py-1.5 rounded-xl text-emerald-400 hover:text-emerald-300 hover:bg-slate-900/80 transition-colors font-semibold flex items-center gap-1.5 whitespace-nowrap"
      >
        <span>Marketplace</span>
      </a>
      <a 
        href="/marketplace?category=result_based" 
        class="px-2 xl:px-2.5 py-1.5 rounded-xl text-slate-300 hover:text-white hover:bg-slate-900/80 transition-colors font-medium flex items-center gap-1.5 whitespace-nowrap"
      >
        <span class="hidden lg:inline">Enterprise Jobs</span>
        <span class="lg:hidden">Jobs</span>
      </a>
      <a 
        href="/audit" 
        class="hidden md:inline-flex items-center gap-1.5 px-2 xl:px-2.5 py-1.5 rounded-xl text-teal-400 hover:text-teal-300 hover:bg-slate-900/80 transition-colors font-medium whitespace-nowrap"
        title="RepoPulse: Free 30s GitHub Architecture & AI Audit"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-teal-400 animate-pulse"></span>
        <span>RepoPulse</span>
      </a>
      <a 
        href="/#products" 
        class="hidden lg:inline-block px-2 xl:px-2.5 py-1.5 rounded-xl hover:text-white hover:bg-slate-900/80 transition-colors whitespace-nowrap"
      >
        Platform
      </a>
      <a 
        href="/#cases" 
        class="hidden lg:inline-block px-2 xl:px-2.5 py-1.5 rounded-xl hover:text-white hover:bg-slate-900/80 transition-colors whitespace-nowrap"
      >
        Solutions
      </a>
    </nav>

    <!-- Desktop Right Action Cluster -->
    <div class="hidden lg:flex items-center gap-2 xl:gap-2.5 flex-shrink-0">
      <!-- Official X -->
      <a 
        href="https://x.com/TheAgentMarket" 
        target="_blank" 
        rel="noreferrer"
        class="hidden xl:flex items-center gap-1.5 px-2.5 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-800 hover:border-slate-700 transition-all text-xs font-mono font-medium"
        title="Official X: @TheAgentMarket"
      >
        <svg class="w-3.5 h-3.5 fill-current text-slate-400" viewBox="0 0 24 24">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
        <span>X</span>
      </a>

      <!-- Orders Drawer Button (Visible only after enterprise authentication) -->
      <button 
        id="btn-nav-orders-top"
        onclick="if(window.openOrdersDrawer){window.openOrdersDrawer();}else{window.dispatchEvent(new Event('open_orders_drawer'));}"
        class="hidden text-xs font-semibold px-2.5 xl:px-3 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-800 hover:border-cyan-500/50 transition-all flex items-center gap-1.5 active:scale-95 whitespace-nowrap cursor-pointer"
        title="View Hired Orders"
      >
        <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
        </svg>
        <span>Orders</span>
      </button>

      <!-- Connect Agent CTA -->
      <a 
        href="/create" 
        class="text-xs font-semibold px-3.5 xl:px-4 py-2 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-500 hover:from-emerald-500 hover:to-teal-400 text-white transition-all shadow-md shadow-emerald-600/20 flex items-center gap-1.5 active:scale-95 whitespace-nowrap cursor-pointer"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        <span>Connect Agent</span>
      </a>

      <!-- Unauthenticated State: Sign In Button with Hover Connect Wallet Dropdown -->
      <div id="nav-signin-wrapper" class="relative group">
        <button 
          id="btn-nav-signin"
          onclick="if(window.openAuthModal){window.openAuthModal();}else{window.dispatchEvent(new Event('open_auth_modal'));}"
          class="text-xs font-semibold px-3 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-800 hover:border-slate-700 transition-all flex items-center gap-1.5 active:scale-95 whitespace-nowrap cursor-pointer"
          title="Click to sign in with GitHub or Google"
        >
          <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
          </svg>
          <span>Sign In</span>
          <svg class="w-3 h-3 text-slate-500 group-hover:text-emerald-400 transition-transform group-hover:translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Hover Dropdown: Quick Connect Web3 Wallet -->
        <div class="absolute right-0 top-full pt-2 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-200 z-50">
          <div class="w-56 p-2 bg-slate-900/95 backdrop-blur-xl border border-slate-800 rounded-2xl shadow-2xl shadow-emerald-950/40">
            <div class="text-[10px] font-mono text-slate-400 uppercase tracking-wider px-2.5 py-1 flex items-center justify-between">
              <span>Web3 Identity</span>
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            </div>
            
            <button 
              id="btn-nav-wallet"
              onclick="if(window.connectAgentUniverWallet){window.connectAgentUniverWallet();}else{window.dispatchEvent(new Event('trigger_connect_wallet'));}"
              class="w-full flex items-center gap-2.5 px-3 py-2.5 rounded-xl bg-slate-800/80 hover:bg-emerald-500/10 text-slate-200 hover:text-emerald-400 border border-slate-700/60 hover:border-emerald-500/30 transition-all text-xs font-semibold group/wallet cursor-pointer mt-1"
            >
              <svg class="w-4 h-4 text-emerald-400 group-hover/wallet:scale-110 transition-transform flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
              <div class="flex flex-col text-left truncate">
                <span id="wallet-address-display">Connect Wallet</span>
                <span class="text-[10px] text-slate-400 font-normal">MetaMask / OKX</span>
              </div>
            </button>

            <div class="px-2.5 pt-2 pb-1 text-[10px] text-slate-400 border-t border-slate-800/80 mt-2 flex items-center justify-between">
              <span>Click button for GitHub & Google</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Authenticated State (Hidden by default) -->
      <div id="nav-user-profile" class="hidden relative group">
        <button class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-900 border border-slate-800 hover:border-emerald-500/50 transition cursor-pointer">
          <img id="nav-user-avatar" src="https://api.dicebear.com/7.x/bottts/svg?seed=user" alt="Avatar" class="w-6 h-6 rounded-full bg-slate-800" />
          <span id="nav-user-name" class="text-xs font-semibold text-white max-w-[90px] truncate">Builder</span>
          <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Dropdown -->
        <div class="absolute right-0 top-full mt-2 w-52 py-2 bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-200 z-50">
          <div class="px-4 py-2 border-b border-slate-800/80 flex items-center justify-between text-[11px] text-slate-400 font-mono">
            <span>Wallet</span>
            <span id="profile-wallet-indicator" class="text-emerald-400 truncate max-w-[110px]">Not Connected</span>
          </div>
          <a href="/create" class="block px-4 py-2 text-xs text-slate-300 hover:text-white hover:bg-slate-800">
            Registered Agents
          </a>
          <button 
            id="btn-view-hired-tasks" 
            onclick="if(window.openOrdersDrawer){window.openOrdersDrawer();}else{window.dispatchEvent(new Event('open_orders_drawer'));}"
            class="w-full text-left block px-4 py-2 text-xs text-slate-300 hover:text-white hover:bg-slate-800 cursor-pointer"
          >
            My Hired Orders
          </button>
          <div class="border-t border-slate-800 my-1"></div>
          <button id="btn-nav-signout" class="w-full text-left block px-4 py-2 text-xs text-rose-400 hover:bg-rose-500/10 cursor-pointer">
            Sign Out
          </button>
        </div>
      </div>
    </div>

    <!-- Mobile Header Right Actions (Clean & Compact) -->
    <div class="flex items-center gap-1.5 sm:gap-2 lg:hidden">
      <!-- Direct Marketplace Mobile Link -->
      <a 
        href="/marketplace"
        class="flex items-center gap-1 px-2 sm:px-2.5 py-1.5 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-semibold hover:bg-emerald-500/20 transition active:scale-95"
        title="Agent Marketplace"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="hidden xs:inline">Marketplace</span>
        <span class="xs:hidden">Market</span>
      </a>

      <!-- Quick Compact Wallet Indicator for Mobile -->
      <button 
        id="btn-mobile-wallet-quick"
        onclick="if(window.connectAgentUniverWallet){window.connectAgentUniverWallet();}else{window.dispatchEvent(new Event('trigger_connect_wallet'));}"
        type="button"
        class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl bg-slate-900 border border-slate-800 text-slate-300 text-xs hover:border-emerald-500/40 transition active:scale-95 cursor-pointer"
        title="Web3 Wallet"
      >
        <span class="w-2 h-2 rounded-full bg-slate-500" id="wallet-status-dot-mobile"></span>
        <span id="wallet-address-display-mobile" class="font-mono text-[11px]">Wallet</span>
      </button>

      <!-- Mobile Hamburger Toggle -->
      <button 
        id="mobile-menu-toggle"
        type="button" 
        class="p-2 rounded-xl text-slate-400 hover:text-white hover:bg-slate-900 border border-transparent hover:border-slate-800 focus:outline-none transition active:scale-95 cursor-pointer"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden lg:hidden border-b border-slate-800 bg-slate-950/98 px-5 py-5 space-y-2 text-sm font-medium text-slate-300 shadow-2xl">
    <a href="/marketplace" class="block px-3.5 py-2.5 rounded-xl text-emerald-400 font-bold bg-emerald-500/10 border border-emerald-500/20 mobile-link">
      Explore Marketplace
    </a>
    <a href="/marketplace?category=result_based" class="block px-3.5 py-2 rounded-xl text-cyan-400 font-semibold hover:bg-slate-900 mobile-link">
      Enterprise Jobs (Result-Based)
    </a>
    <a href="/audit" class="flex items-center justify-between px-3.5 py-2 rounded-xl text-teal-300 font-semibold hover:bg-slate-900 mobile-link">
      <span>RepoPulse (Free Audit)</span>
      <span class="w-1.5 h-1.5 rounded-full bg-teal-400 animate-pulse"></span>
    </a>
    <button 
      id="btn-mobile-orders" 
      onclick="if(window.openOrdersDrawer){window.openOrdersDrawer();}else{window.dispatchEvent(new Event('open_orders_drawer'));}"
      class="hidden w-full text-left block px-3.5 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-slate-900 mobile-link"
    >
      My Hired Orders
    </button>
    <a href="/#products" class="block px-3.5 py-2 rounded-xl hover:text-white hover:bg-slate-900 mobile-link">
      Platform Architecture
    </a>
    <a href="/#cases" class="block px-3.5 py-2 rounded-xl hover:text-white hover:bg-slate-900 mobile-link">
      Ecosystem Case Studies
    </a>
    <a href="/#team" class="block px-3.5 py-2 rounded-xl hover:text-white hover:bg-slate-900 mobile-link">
      Governance & Stewardship
    </a>
    <a href="/#company" class="block px-3.5 py-2 rounded-xl hover:text-white hover:bg-slate-900 mobile-link">
      Company & Mission
    </a>

    <div class="pt-4 border-t border-slate-900 space-y-2.5">
      <a 
        href="/create" 
        class="w-full block text-center text-xs font-semibold py-3 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-500 text-white shadow-md shadow-emerald-600/20 mobile-link active:scale-95"
      >
        + Connect Your Agent
      </a>
      <button 
        id="btn-mobile-signin"
        onclick="if(window.openAuthModal){window.openAuthModal();}else{window.dispatchEvent(new Event('open_auth_modal'));}"
        class="w-full block text-center text-xs font-semibold py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-slate-200 hover:bg-slate-800 active:scale-95 cursor-pointer"
      >
        Sign In
      </button>
    </div>
  </div>
</header>

<script>
  import { getCurrentUserProfile, signOutUser } from '../lib/supabase';

  const navSignInWrapper = document.getElementById('nav-signin-wrapper');
  const btnSignIn = document.getElementById('btn-nav-signin');
  const btnMobileSignIn = document.getElementById('btn-mobile-signin');
  const userProfileEl = document.getElementById('nav-user-profile');
  const userAvatarEl = document.getElementById('nav-user-avatar') as HTMLImageElement;
  const userNameEl = document.getElementById('nav-user-name');
  const btnSignOut = document.getElementById('btn-nav-signout');
  const btnNavOrdersTop = document.getElementById('btn-nav-orders-top');
  const btnMobileOrders = document.getElementById('btn-mobile-orders');
  const btnViewHiredTasks = document.getElementById('btn-view-hired-tasks');

  btnNavOrdersTop?.addEventListener('click', () => {
    window.dispatchEvent(new Event('open_orders_drawer'));
  });

  btnMobileOrders?.addEventListener('click', () => {
    window.dispatchEvent(new Event('open_orders_drawer'));
  });

  btnViewHiredTasks?.addEventListener('click', () => {
    window.dispatchEvent(new Event('open_orders_drawer'));
  });

  async function updateAuthUI() {
    try {
      const user = await getCurrentUserProfile();
      if (user) {
        if (navSignInWrapper) navSignInWrapper.classList.add('hidden');
        if (btnSignIn) btnSignIn.classList.add('hidden');
        if (btnNavOrdersTop) btnNavOrdersTop.classList.remove('hidden');
        if (btnMobileOrders) btnMobileOrders.classList.remove('hidden');
        if (btnMobileSignIn) btnMobileSignIn.textContent = 'Account: ' + user.name;
        if (userProfileEl) userProfileEl.classList.remove('hidden');
        if (userAvatarEl) userAvatarEl.src = user.avatarUrl;
        if (userNameEl) userNameEl.textContent = user.name;
      } else {
        if (navSignInWrapper) navSignInWrapper.classList.remove('hidden');
        if (btnSignIn) btnSignIn.classList.remove('hidden');
        if (btnNavOrdersTop) btnNavOrdersTop.classList.add('hidden');
        if (btnMobileOrders) btnMobileOrders.classList.add('hidden');
        if (btnMobileSignIn) btnMobileSignIn.textContent = 'Sign In';
        if (userProfileEl) userProfileEl.classList.add('hidden');
      }
    } catch (e) {
      console.warn('Auth check error:', e);
    }
  }

  btnSignIn?.addEventListener('click', () => {
    window.dispatchEvent(new Event('open_auth_modal'));
  });

  btnMobileSignIn?.addEventListener('click', () => {
    window.dispatchEvent(new Event('open_auth_modal'));
  });

  btnSignOut?.addEventListener('click', async () => {
    await signOutUser();
    updateAuthUI();
  });

  window.addEventListener('agentuniver_auth_change', updateAuthUI);
  updateAuthUI();

  // Web3 Wallet Connect Logic
  const btnWallet = document.getElementById('btn-nav-wallet');
  const btnMobileWalletQuick = document.getElementById('btn-mobile-wallet-quick');
  const walletDisplay = document.getElementById('wallet-address-display');
  const walletDot = document.getElementById('wallet-status-dot');
  const walletDisplayMobile = document.getElementById('wallet-address-display-mobile');
  const walletDotMobile = document.getElementById('wallet-status-dot-mobile');

  async function connectWallet() {
    if (typeof (window as any).ethereum !== 'undefined') {
      try {
        const accounts = await (window as any).ethereum.request({ method: 'eth_requestAccounts' });
        if (accounts && accounts.length > 0) {
          const acc = accounts[0];
          localStorage.setItem('agentuniver_wallet', acc);
          updateWalletUI(acc);

          // Auto-sync wallet identity to platform user profile if not logged in
          const cachedUser = localStorage.getItem('agentuniver_auth_user');
          if (!cachedUser) {
            const web3User = {
              id: 'did:eth:' + acc,
              email: `${acc.substring(0, 6)}...${acc.substring(acc.length - 4)}@web3.eth`,
              name: `${acc.substring(0, 6)}...${acc.substring(acc.length - 4)}`,
              avatarUrl: `https://api.dicebear.com/7.x/identicon/svg?seed=${acc}`,
              role: 'developer'
            };
            localStorage.setItem('agentuniver_auth_user', JSON.stringify(web3User));
            window.dispatchEvent(new Event('agentuniver_auth_change'));
          }

          window.dispatchEvent(new CustomEvent('agentuniver_wallet_connected', { detail: { address: acc } }));
          if ((window as any).showPageAlert) {
            (window as any).showPageAlert({
              type: 'success',
              title: 'Wallet Connected',
              message: `Connected account ${acc.substring(0, 6)}...${acc.substring(acc.length - 4)} successfully.`,
              duration: 4000
            });
          }
        }
      } catch (err: any) {
        console.error('Wallet connection rejected:', err);
      }
    } else {
      if ((window as any).showPageAlert) {
        (window as any).showPageAlert({
          type: 'warning',
          title: 'Web3 Wallet Required',
          message: 'No Web3 wallet detected. Please install MetaMask or OKX Wallet to connect your decentralized identity.',
          action: {
            label: 'Install MetaMask',
            url: 'https://metamask.io/download/'
          },
          duration: 7000
        });
      } else {
        alert('No Web3 wallet detected. Please install MetaMask or OKX Wallet.');
      }
    }
  }

  // Expose to window and add event listener for trigger_connect_wallet
  (window as any).connectAgentUniverWallet = connectWallet;
  window.addEventListener('trigger_connect_wallet', connectWallet);

  function updateWalletUI(address?: string) {
    const saved = address || localStorage.getItem('agentuniver_wallet');
    const profileWallet = document.getElementById('profile-wallet-indicator');
    if (saved) {
      const shortAddr = saved.substring(0, 6) + '...' + saved.substring(saved.length - 4);
      if (walletDisplay) walletDisplay.textContent = shortAddr;
      if (walletDot) walletDot.className = 'w-2 h-2 rounded-full bg-emerald-400 animate-pulse';
      if (walletDisplayMobile) walletDisplayMobile.textContent = shortAddr;
      if (walletDotMobile) walletDotMobile.className = 'w-2 h-2 rounded-full bg-emerald-400 animate-pulse';
      if (profileWallet) profileWallet.textContent = shortAddr;
    } else {
      if (walletDisplay) walletDisplay.textContent = 'Connect Wallet';
      if (walletDot) walletDot.className = 'w-2 h-2 rounded-full bg-slate-500';
      if (walletDisplayMobile) walletDisplayMobile.textContent = 'Wallet';
      if (walletDotMobile) walletDotMobile.className = 'w-2 h-2 rounded-full bg-slate-500';
      if (profileWallet) profileWallet.textContent = 'Not Connected';
    }
  }

  btnWallet?.addEventListener('click', connectWallet);
  btnMobileWalletQuick?.addEventListener('click', connectWallet);
  updateWalletUI();

  // Mobile menu
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  toggleBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
    });
  });
</script>
