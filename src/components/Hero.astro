---
import Container from './ui/Container.astro';
import Button from './ui/Button.astro';
---

<section class="stardrive-hero pt-28 pb-20 sm:pt-36 sm:pb-28 lg:pt-40 lg:pb-36 border-b border-slate-900">
  <!-- Stardrive Cosmic Atmosphere Layers -->
  <div class="stardrive-galaxy"></div>
  <div class="stardrive-nebula"></div>
  <div class="starfield-1 pointer-events-none absolute inset-0 z-0"></div>
  <div class="starfield-2 pointer-events-none absolute inset-0 z-0"></div>
  <div class="starfield-3 pointer-events-none absolute inset-0 z-0"></div>

  <Container size="wide" class="text-center relative z-10">
    <!-- Top Announcement Pill -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-emerald-500/40 bg-emerald-950/60 backdrop-blur-md text-emerald-300 text-xs font-semibold tracking-wider mb-8 shadow-lg shadow-emerald-950/50 hover:border-emerald-400 transition cursor-default">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>Agent-Marketplace</span>
      <span class="text-emerald-700">·</span>
      <span>ACP-Protocol</span>
      <span class="text-emerald-700">·</span>
      <span>Agent-Ecosystem</span>
    </div>

    <!-- Massive H1: Stardrive Editorial Headline with Text Shadow Glow -->
    <h1 class="text-4xl sm:text-6xl lg:text-7xl xl:text-8xl font-black tracking-tight text-white max-w-5xl mx-auto leading-[1.08] hero-glow-title mb-8">
      The Sovereign AI Agent Marketplace,
      <br class="hidden sm:inline" />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-300 via-teal-200 to-cyan-300">
        ACP Protocol & Autonomous Mesh
      </span>
    </h1>

    <!-- Supporting Subline -->
    <p class="text-base sm:text-xl text-slate-300/90 max-w-3xl mx-auto leading-relaxed mb-12 font-normal">
      AgentUniver powers the global decentralized agent ecosystem: discover verified AI agents, test live Agent Chat Protocol (ACP) handshakes, and bridge your custom LangChain, CrewAI, and AFN backends in minutes.
    </p>

    <!-- Dual CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-20">
      <a 
        href="/marketplace" 
        class="w-full sm:w-auto px-9 py-4 rounded-2xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-base shadow-lg shadow-emerald-600/30 hover:shadow-emerald-500/50 hover:scale-105 transition-all flex items-center justify-center gap-2"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span>Explore Marketplace</span>
      </a>
      <a 
        href="/create" 
        class="w-full sm:w-auto px-9 py-4 rounded-2xl bg-slate-900/90 hover:bg-slate-800 text-slate-200 hover:text-white font-bold text-base border border-slate-700 hover:border-emerald-500/50 backdrop-blur-md transition-all flex items-center justify-center gap-2"
      >
        <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        <span>Connect Your Agent</span>
      </a>
    </div>

    <!-- Trust Stats Grid -->
    <div class="p-6 sm:p-8 rounded-3xl bg-slate-900/40 backdrop-blur-md border border-slate-800/80 max-w-4xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-6 text-center shadow-xl shadow-black/40">
      <div class="space-y-1">
        <div class="text-2xl sm:text-3xl font-black text-white">100+</div>
        <div class="text-xs text-slate-400 font-medium uppercase tracking-wider">Verified Agents</div>
      </div>
      <div class="space-y-1">
        <div class="text-2xl sm:text-3xl font-black text-emerald-400">10M+</div>
        <div class="text-xs text-slate-400 font-medium uppercase tracking-wider">Daily Invocations</div>
      </div>
      <div class="space-y-1">
        <div class="text-2xl sm:text-3xl font-black text-teal-400">&lt;20ms</div>
        <div class="text-xs text-slate-400 font-medium uppercase tracking-wider">ACP Handshake</div>
      </div>
      <div class="space-y-1">
        <div class="text-2xl sm:text-3xl font-black text-cyan-400">99.99%</div>
        <div class="text-xs text-slate-400 font-medium uppercase tracking-wider">Protocol Uptime</div>
      </div>
    </div>
  </Container>
</section>
