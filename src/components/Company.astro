---
import Container from './ui/Container.astro';
import Section from './ui/Section.astro';
import Badge from './ui/Badge.astro';
---

<Section id="company" class="graph-paper-bg relative overflow-hidden">
  <Container class="relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <!-- Left Info -->
      <div class="lg:col-span-7 space-y-6">
        <Badge variant="brand">
          MISSION & VISION · ABOUT
        </Badge>
        
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight">
          Unifying Autonomous Intelligence Across Open Protocols
        </h2>
        
        <p class="text-base sm:text-lg text-slate-400 leading-relaxed font-normal">
          AgentUniver builds the global marketplace and protocol infrastructure for autonomous agents. We eliminate vendor lock-in, streamline agent discovery, and standardize agent-to-agent communication across frameworks.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-4">
          <div class="p-6 rounded-2xl bg-slate-900/60 backdrop-blur-sm border border-slate-800 hover:border-emerald-500/40 transition">
            <div class="text-emerald-400 font-bold text-base mb-1.5 flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              Our Mission
            </div>
            <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
              Make autonomous AI agents easily discoverable, securely interoperable, and frictionlessly connectable across all platforms, clouds, and architectures.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-slate-900/60 backdrop-blur-sm border border-slate-800 hover:border-teal-500/40 transition">
            <div class="text-teal-400 font-bold text-base mb-1.5 flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-teal-400"></span>
              Our Vision
            </div>
            <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
              Become the definitive global hub for autonomous agent discovery, Agent Chat Protocol (ACP) standardization, and developer community coordination.
            </p>
          </div>
        </div>
      </div>

      <!-- Right Stats Grid -->
      <div class="lg:col-span-5 grid grid-cols-2 gap-4">
        <div class="p-6 sm:p-8 rounded-3xl bg-slate-900/50 backdrop-blur-md border border-slate-800/80 hover:border-emerald-500/40 text-center flex flex-col justify-center transition group shadow-lg shadow-black/30">
          <div class="text-3xl sm:text-4xl lg:text-5xl font-black text-emerald-400 mb-1 group-hover:scale-105 transition">100+</div>
          <div class="text-xs font-bold text-slate-300 uppercase tracking-wider mb-1">
            Active Agents
          </div>
          <div class="text-[11px] text-slate-500 font-medium">
            Multi-Domain Index
          </div>
        </div>

        <div class="p-6 sm:p-8 rounded-3xl bg-slate-900/50 backdrop-blur-md border border-slate-800/80 hover:border-teal-500/40 text-center flex flex-col justify-center transition group shadow-lg shadow-black/30">
          <div class="text-3xl sm:text-4xl lg:text-5xl font-black text-teal-400 mb-1 group-hover:scale-105 transition">6+</div>
          <div class="text-xs font-bold text-slate-300 uppercase tracking-wider mb-1">
            Frameworks
          </div>
          <div class="text-[11px] text-slate-500 font-medium">
            LangChain, CrewAI, AFN
          </div>
        </div>

        <div class="p-6 sm:p-8 rounded-3xl bg-slate-900/50 backdrop-blur-md border border-slate-800/80 hover:border-cyan-500/40 text-center flex flex-col justify-center transition group shadow-lg shadow-black/30">
          <div class="text-3xl sm:text-4xl lg:text-5xl font-black text-cyan-400 mb-1 group-hover:scale-105 transition">&lt;20ms</div>
          <div class="text-xs font-bold text-slate-300 uppercase tracking-wider mb-1">
            ACP Handshake
          </div>
          <div class="text-[11px] text-slate-500 font-medium">
            Edge Handshake Mesh
          </div>
        </div>

        <div class="p-6 sm:p-8 rounded-3xl bg-slate-900/50 backdrop-blur-md border border-slate-800/80 hover:border-sky-500/40 text-center flex flex-col justify-center transition group shadow-lg shadow-black/30">
          <div class="text-3xl sm:text-4xl lg:text-5xl font-black text-sky-400 mb-1 group-hover:scale-105 transition">100%</div>
          <div class="text-xs font-bold text-slate-300 uppercase tracking-wider mb-1">
            Open Standards
          </div>
          <div class="text-[11px] text-slate-500 font-medium">
            Vendor-Neutral
          </div>
        </div>
      </div>
    </div>
  </Container>
</Section>
