---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import MarketplaceShowcase from '../components/MarketplaceShowcase.astro';
import Company from '../components/Company.astro';
import Products from '../components/Products.astro';
import Cases from '../components/Cases.astro';
import Team from '../components/Team.astro';
import Partners from '../components/Partners.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="AgentUniver - Autonomous AI Workspace & Agent Fabric"
  description="AgentUniver Corporate Portal & Agent Marketplace: Discover, create, and connect autonomous AI agents across LibraOn, LibraFlux, OhBona, and the Agent-Friendly Network (AFN)."
>
  <Header />
  <main>
    <Hero />
    <MarketplaceShowcase />
    <Company />
    <Products />
    <Cases />
    <Team />
    <Partners />
    <Contact />
  </main>
  <Footer />
</Layout>
