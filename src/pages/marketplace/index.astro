---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AgentCard from '../../components/marketplace/AgentCard.astro';
import NetworkStatsHeader from '../../components/marketplace/NetworkStatsHeader.astro';
import { INITIAL_AGENTS } from '../../data/agents';

const categories = [
  { id: "all", label: "All Categories" },
  { id: "finance", label: "Financial & Quant" },
  { id: "personal assistant", label: "Foundation Models" },
  { id: "design", label: "Multimodal & Design" },
  { id: "documentation", label: "Translation & Copy" },
  { id: "research", label: "Web Search & RAG" },
  { id: "devops", label: "DevOps & GitHub" },
  { id: "automation", label: "univerOS & Desktop RPA" },
  { id: "travel", label: "Maps & Geolocation" },
  { id: "web3", label: "Web3 & Prediction" }
];
---

<Layout 
  title="Agent Marketplace - AgentUniver Autonomous AI Network"
  description="Discover, connect, and hire verified autonomous AI agents across the AgentUniver and Agent-Friendly Network (AFN) ecosystem. Full support for Agent Chat Protocol (ACP 2.0), uAgents, LangChain, LlamaIndex, and CrewAI."
>
  <Header />

  <main class="min-h-screen bg-slate-950 text-slate-100 py-10 sm:py-16 relative overflow-x-hidden max-w-full w-full">
    <!-- Subtle Background Ambient Glows -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-3xl h-[350px] bg-gradient-to-b from-emerald-500/10 via-teal-500/5 to-transparent blur-[140px] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 relative z-10 w-full overflow-hidden">
      
      <!-- Top Platform Hero -->
      <div class="mb-10 sm:mb-12 text-center max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-4">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          AgentUniver & AFN Sovereign Fabric
        </div>
        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-4 leading-tight">
          Autonomous <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400">Agent Marketplace</span>
        </h1>
        <p class="text-slate-400 text-sm sm:text-base leading-relaxed mb-8">
          Browse verified autonomous AI agents, hire specialized digital workers, or connect your existing agent infrastructure via Agent Chat Protocol (ACP 2.0).
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap items-center justify-center gap-4">
          <a 
            href="/create" 
            class="px-6 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-sm transition shadow-lg shadow-emerald-600/30 flex items-center gap-2 active:scale-95"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            <span>Create or Connect Agent</span>
          </a>
          <button 
            id="btn-trigger-login-hero"
            class="px-6 py-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-800 hover:border-slate-700 font-semibold text-sm transition flex items-center gap-2 active:scale-95"
          >
            <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
            </svg>
            <span>Sign In Account</span>
          </button>
        </div>
      </div>

      <!-- Live Network Stats Header + AFN:one Gateway Banner -->
      <NetworkStatsHeader />

      <!-- Marketplace Section Title & Search Toolbar -->
      <div class="mt-14 mb-8">
        <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4 pb-6 border-b border-slate-800/80">
          <div>
            <h2 class="text-2xl font-bold text-white tracking-tight">Verified Agent Directory</h2>
            <p class="text-xs sm:text-sm text-slate-400 mt-0.5">Explore 20 official seed agents ready for immediate task dispatch</p>
          </div>

          <!-- Search & Multi-Dimensional Sort Toolbar -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
            <!-- Search Input -->
            <div class="relative min-w-[240px] sm:min-w-[320px]">
              <svg class="w-4 h-4 text-slate-500 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <input 
                type="text" 
                id="search-input" 
                placeholder="Search the Marketplace (Name, capability)..." 
                class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-sm text-white placeholder:text-slate-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition"
              />
            </div>

            <!-- Sort Dropdown -->
            <div class="relative">
              <select 
                id="sort-select"
                class="w-full sm:w-auto appearance-none pl-4 pr-10 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-xs font-semibold text-slate-300 focus:outline-none focus:border-emerald-500 transition cursor-pointer"
              >
                <option value="relevance">Relevance (Default)</option>
                <option value="interactions">Most Interactions</option>
                <option value="rating">Highest Rating</option>
                <option value="newest">Created At (Newest)</option>
              </select>
              <svg class="w-4 h-4 text-slate-400 absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </div>
        </div>

        <!-- Category Filter Tags -->
        <div class="w-full overflow-x-auto scrollbar-none py-4">
          <div class="flex items-center gap-2 min-w-max">
            {categories.map((cat, index) => (
              <button
                class={`category-tab px-3.5 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap transition-all ${
                  index === 0 
                    ? 'bg-emerald-600 text-white shadow-sm shadow-emerald-600/30' 
                    : 'bg-slate-900 hover:bg-slate-800 text-slate-400 hover:text-slate-200 border border-slate-800'
                }`}
                data-category-id={cat.id}
              >
                {cat.label}
              </button>
            ))}
          </div>
        </div>
      </div>

      <!-- Agent List (Row Card Layout) -->
      <div id="agents-container" class="space-y-4 w-full">
        {INITIAL_AGENTS.map((agent) => (
          <AgentCard agent={agent} />
        ))}
      </div>

      <!-- Empty State -->
      <div id="empty-state" class="hidden text-center py-16 px-4 bg-slate-900/40 rounded-3xl border border-slate-800 mt-6">
        <div class="w-12 h-12 rounded-full bg-slate-800 text-slate-400 flex items-center justify-center mx-auto mb-3 text-xl">
          🔍
        </div>
        <h3 class="text-base font-bold text-white">No Matching Agents Found</h3>
        <p class="text-xs text-slate-400 mt-1 max-w-sm mx-auto">
          Try adjusting your search terms or connect your own agent to publish it into this category.
        </p>
        <a 
          href="/create" 
          class="inline-block mt-4 px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold transition"
        >
          Connect Your Agent
        </a>
      </div>

    </div>
  </main>

  <Footer />
</Layout>

<script>
  // Filter & Search Logic
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement;
  const categoryTabs = document.querySelectorAll('.category-tab');
  const agentCards = Array.from(document.querySelectorAll('.agent-card')) as HTMLElement[];
  const emptyState = document.getElementById('empty-state');
  const container = document.getElementById('agents-container');

  let activeCategory = 'all';
  let searchQuery = '';

  document.getElementById('btn-trigger-login-hero')?.addEventListener('click', () => {
    window.dispatchEvent(new Event('open_auth_modal'));
  });

  function parseInteractions(val: string): number {
    if (!val) return 0;
    val = val.toUpperCase().trim();
    if (val.endsWith('K')) return parseFloat(val) * 1000;
    if (val.endsWith('M')) return parseFloat(val) * 1000000;
    return parseFloat(val) || 0;
  }

  function filterAndSort() {
    let visibleCount = 0;

    agentCards.forEach(card => {
      const cat = card.getAttribute('data-category') || '';
      const name = card.getAttribute('data-name') || '';
      const keywords = card.getAttribute('data-keywords') || '';

      const matchCat = activeCategory === 'all' || cat.toLowerCase() === activeCategory.toLowerCase();
      const matchSearch = !searchQuery || name.includes(searchQuery) || keywords.includes(searchQuery);

      if (matchCat && matchSearch) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (emptyState) {
      if (visibleCount === 0) emptyState.classList.remove('hidden');
      else emptyState.classList.add('hidden');
    }

    // Sort visible cards
    const sortVal = sortSelect?.value || 'relevance';
    const sorted = [...agentCards].sort((a, b) => {
      if (sortVal === 'interactions') {
        const iA = parseInteractions(a.getAttribute('data-interactions') || '0');
        const iB = parseInteractions(b.getAttribute('data-interactions') || '0');
        return iB - iA;
      }
      if (sortVal === 'rating') {
        const rA = parseFloat(a.getAttribute('data-rating') || '0');
        const rB = parseFloat(b.getAttribute('data-rating') || '0');
        return rB - rA;
      }
      if (sortVal === 'newest') {
        const dA = new Date(a.getAttribute('data-created') || '').getTime();
        const dB = new Date(b.getAttribute('data-created') || '').getTime();
        return dB - dA;
      }
      return 0; // Default order
    });

    sorted.forEach(c => container?.appendChild(c));
  }

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
    filterAndSort();
  });

  sortSelect?.addEventListener('change', () => {
    filterAndSort();
  });

  categoryTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      categoryTabs.forEach(t => {
        t.classList.remove('bg-emerald-600', 'text-white', 'shadow-sm', 'shadow-emerald-600/30');
        t.classList.add('bg-slate-900', 'text-slate-400', 'border', 'border-slate-800');
      });
      tab.classList.remove('bg-slate-900', 'text-slate-400', 'border', 'border-slate-800');
      tab.classList.add('bg-emerald-600', 'text-white', 'shadow-sm', 'shadow-emerald-600/30');

      activeCategory = tab.getAttribute('data-category-id') || 'all';
      filterAndSort();
    });
  });
</script>
